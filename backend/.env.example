# Copy to .env and fill in. Never commit .env.
PORT=5001
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Frontend origin allowed to open socket connections
CLIENT_URL=http://localhost:3000

# ---------- Database ----------
# Leave DATABASE_URL unset to use a local SQLite file (SQLITE_PATH). Set it to use PostgreSQL,
# e.g. Supabase: Project Settings -> Database -> Connection string -> "Session pooler".
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SQLITE_PATH=./data/chat.sqlite
# Optional: path to the provider's CA certificate so the database's identity is verified
# (Supabase: Database settings -> SSL Configuration -> Download certificate)
# DATABASE_CA_CERT=./certs/supabase-ca.crt
# Demo users with a known password. Defaults to true for SQLite, false for PostgreSQL —
# never enable it on a database reachable from the internet.
# SEED_DEMO_DATA=false
# Encrypts two-factor (authenticator app) secrets in the database. At least 32 characters;
# generate like JWT_SECRET. Changing it later invalidates every user's 2FA setup.
TWO_FACTOR_KEY=change-me-to-a-long-random-string

# ---------- Real-time across copies ----------
# Leave unset for a single copy. With several copies, set it so they share live events
# (e.g. redis://localhost:6379 for a local Valkey/Redis, or a managed Redis URL).
# REDIS_URL=redis://localhost:6379
# Per-message delivery lines in the log (evidence for the experiment). Turn off for load tests.
# LOG_DELIVERY=true
